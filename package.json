{
  "name": "pitch-changer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "./wasm/run-build.sh",
    "build:ts": "eslint ./src/** && tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:ts && npm run test:wasm",
    "test:ts": "vitest run",
    "test:wasm": "cd wasm && cargo test --release",
    "test:wasm-integration": "npm run build:wasm && WASM_INTEGRATION=true vitest run src/wasm-integration.test.ts",
    "clippy": "cd wasm && cargo clippy",
    "build:extension": "npm run build:wasm && npm run --prefix extension build:extension",
    "package:extension": "npm run build:wasm && npm run --prefix extension package:extension"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mediabunny/mp3-encoder": "^1.61.0",
    "mediabunny": "^1.61.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^26.6.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "binaryen": "^132.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
